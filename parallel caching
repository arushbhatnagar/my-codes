remaining = df_full[~df_full['log_id'].isin(already_cached_ids)].copy()
print(f"Already cached: {len(already_cached_ids)}")
print(f"Remaining uncached in the 3-month pool: {len(remaining)}")

subtype_have = {}
for d in all_traces_combined.values():
    st = d.get('subtype')
    subtype_have[st] = subtype_have.get(st, 0) + 1

SAMPLES_PER_SUBTYPE = 15
under_sampled = [st for st in remaining['activity_subtype'].unique() if subtype_have.get(st, 0) < SAMPLES_PER_SUBTYPE]
to_sample = remaining[remaining['activity_subtype'].isin(under_sampled)].copy()
to_sample['has_raw_cached'] = to_sample.apply(
    lambda r: f"{r['user_id']}-{r['date_str']}-packets.csv" in cached_files, axis=1
)
to_sample = to_sample.sort_values('has_raw_cached', ascending=False)

df_new_batch = to_sample.groupby('activity_subtype').head(SAMPLES_PER_SUBTYPE).sample(
    n=min(150, len(to_sample)), random_state=int(time.time())
)
