import os, pickle, time
import pandas as pd

os.chdir("/Users/arushbhatnagar/Downloads/fw-ds")

with open("all_traces_combined.pkl", "rb") as f:
    all_traces_combined = pickle.load(f)
print(f"Loaded {len(all_traces_combined)} cached traces")

df_full = pd.read_csv("workouts_nonplus_3months.csv")
df_full['activity_subtype'] = df_full['activity_subtype'].fillna("__NO_SUBTYPE__")
