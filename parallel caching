import shutil, subprocess, threading
from concurrent.futures import ThreadPoolExecutor, as_completed

BASE_DIR = "/Users/arushbhatnagar/Downloads/fw-ds"
N_WORKERS = 6
worker_locks = {i: threading.Lock() for i in range(N_WORKERS)}

def process_row_parallel_locked(args):
    row, worker_id = args
    worker_dir = f"{BASE_DIR}_worker{worker_id}"
    if not os.path.exists(worker_dir):
        shutil.copytree(BASE_DIR, worker_dir, ignore=shutil.ignore_patterns('csvs', '.venv', '.git', '*_worker*'))
        os.symlink(f"{BASE_DIR}/csvs", f"{worker_dir}/csvs")
        os.symlink(f"{BASE_DIR}/.venv", f"{worker_dir}/.venv")
    debug_path = f"{worker_dir}/firmware/debug/workout-detection.csv"
    with worker_locks[worker_id]:
        call_start_time = time.time()
        result = subprocess.run(
            [f"{worker_dir}/.venv/bin/python", "simulate.py", row['user_id'], row['date_str']],
            capture_output=True, text=True, cwd=worker_dir, env=os.environ.copy()
        )
        if result.returncode != 0:
            combined_output = (result.stdout + result.stderr)[-500:]
            if "non_json_response" in combined_output or "sign-in" in combined_output:
                return row['log_id'], None, "AUTH_STALE"
            return row['log_id'], None, "OTHER_FAIL"
        if not os.path.exists(debug_path) or os.path.getsize(debug_path) < 1000:
            return row['log_id'], None, "EMPTY_OR_TINY_DEBUG_FILE"
        if os.path.getmtime(debug_path) < call_start_time:
            return row['log_id'], None, "STALE_DEBUG_FILE"
        try:
            dbg = pd.read_csv(debug_path)
        except Exception:
            return row['log_id'], None, "UNREADABLE_DEBUG_FILE"
        start_ms, end_ms = int(row['start_time_ms']), int(row['end_time_ms'])
        win = dbg[(dbg['timestamp'] >= start_ms - 60_000) & (dbg['timestamp'] <= end_ms + 60_000)]
        if len(win) == 0:
            return row['log_id'], None, "NO_MATCHING_WINDOW"
        return row['log_id'], {'window': win, 'label': None, 'subtype': row['activity_subtype']}, None

tasks = [(row, i % N_WORKERS) for i, (_, row) in enumerate(df_new_batch.iterrows())]
new_traces = {}
skip_reasons = {}
start_time = time.time()

with ThreadPoolExecutor(max_workers=N_WORKERS) as ex:
    futures = {ex.submit(process_row_parallel_locked, t): t for t in tasks}
    completed_count = 0
    for fut in as_completed(futures):
        log_id, data, err = fut.result()
        completed_count += 1
        elapsed = round(time.time() - start_time, 1)
        if err == "AUTH_STALE":
            print(f"[{elapsed}s] AUTH STALE - refresh cookie", flush=True)
        elif data is not None:
            new_traces[log_id] = data
            print(f"[{elapsed}s] ({completed_count}/{len(tasks)}) OK: {log_id[:12]}...", flush=True)
        else:
            skip_reasons[err] = skip_reasons.get(err, 0) + 1
            print(f"[{elapsed}s] ({completed_count}/{len(tasks)}) skipped: {err}", flush=True)
        if completed_count % 10 == 0:
            combined_so_far = {**all_traces_combined, **new_traces}
            with open("all_traces_combined.pkl", "wb") as f:
                pickle.dump(combined_so_far, f)
            print(f"  -> Checkpoint: {len(new_traces)} new | skips: {skip_reasons}", flush=True)

all_traces_combined = {**all_traces_combined, **new_traces}
with open("all_traces_combined.pkl", "wb") as f:
    pickle.dump(all_traces_combined, f)
print(f"\nDONE. New: {len(new_traces)}. Combined total: {len(all_traces_combined)}")
